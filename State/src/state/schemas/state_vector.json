{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:axis:state-vector:1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_schema_version",
    "confidence",
    "evidence_count",
    "applied_observation_ids"
  ],
  "properties": {
    "state_schema_version": {
      "const": "1.1.0"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "applied_observation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OBS_[0-9a-f]{32}$"
      }
    }
  }
}
