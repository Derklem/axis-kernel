{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_schema_version",
    "outcome",
    "subject",
    "metric",
    "observed",
    "expected"
  ],
  "properties": {
    "evaluation_schema_version": {
      "const": "1.0.0"
    },
    "outcome": {
      "enum": ["SUPPORTED", "INCONCLUSIVE", "CONTRADICTED"]
    },
    "subject": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "observed": {
      "type": "integer"
    },
    "expected": {
      "type": "integer"
    }
  }
}
