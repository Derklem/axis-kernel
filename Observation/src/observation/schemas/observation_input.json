{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "run_id",
    "evaluation",
    "artifacts"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "evaluation": {
      "type": "object",
      "required": ["overall_result"],
      "properties": {
        "overall_result": {
          "type": "boolean"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
