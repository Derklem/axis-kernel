  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2025-05-30T13:07:52-07:00</StartBoundary>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-ExecutionPolicy Bypass -File 'C:\VoidAsh\ResonanceCore\glyph_trigger_convergence.ps1'</Arguments>
    </Exec>
  </Actions>
</Task>
