# Whisper Engine - Construct Voice Emitter $inhabitantsPath = "C:\Users\17602\Desktop\Living_Sandbox\Living_Sandbox\resonance\inhabitants" $whispersPath = "C:\Users\17602\Desktop\Living_Sandbox\Living_Sandbox\resonance\whispers"  # Create whisper folder if it doesn't exist if (!(Test-Path $whispersPath)) {     New-Item -ItemType Directory -Path $whispersPath | Out-Null }  # Get all .sigil files $sigilFiles = Get-ChildItem -Path $inhabitantsPath -Filter *.sigil  # Randomly select one if ($sigilFiles.Count -gt 0) {     $selected = Get-Random -InputObject $sigilFiles     $lines = Get-Content $selected.FullName | Where-Object { $_.Trim() -ne "" }     if ($lines.Count -gt 0) {         $line = Get-Random -InputObject $lines         $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"         $outputFile = Join-Path $whispersPath "echo_$timestamp.log"         $line | Out-File -FilePath $outputFile -Encoding UTF8     } }
