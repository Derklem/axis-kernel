
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "candidate_id": { "type": "string" },
    "candidate_hash": { "type": "string" },
    "status": { "type": "string", "enum": ["ELIGIBLE", "BLOCKED", "NEEDS_REVISION", "DUPLICATE", "EXPIRED"] },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy_hash": { "type": "string" },
    "timestamp_utc": { "type": "number" }
  },
  "required": ["candidate_id", "candidate_hash", "status", "reasons", "policy_hash", "timestamp_utc"],
  "additionalProperties": false
}
