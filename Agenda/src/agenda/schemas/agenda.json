{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:axis:agenda:agenda:v1.0.0",
    "type": "object",
    "properties": {
        "agenda_schema_version": { "const": "1.0.0" },
        "agenda_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "planner_input_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "planner_spec_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": {
            "type": "string",
            "enum": ["SUCCESS", "FAILED_CONSTRAINTS", "FAILED_INPUT_VALIDATION"]
        },
        "reason_codes": {
            "type": "array",
            "items": { "type": "string" }
        },
        "ranked_items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "candidate_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$", "maxLength": 128, "minLength": 1 },
                    "score": { "type": "integer" }
                },
                "required": ["candidate_id", "score"],
                "additionalProperties": false
            }
        },
        "deferred_items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "candidate_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$", "maxLength": 128, "minLength": 1 },
                    "score": { "type": "integer" },
                    "reason_code": { "type": "string" }
                },
                "required": ["candidate_id", "score", "reason_code"],
                "additionalProperties": false
            }
        },
        "rejected_items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "candidate_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$", "maxLength": 128, "minLength": 1 },
                    "score": { "type": "integer" },
                    "reason_code": { "type": "string" }
                },
                "required": ["candidate_id", "score", "reason_code"],
                "additionalProperties": false
            }
        },
        "summary": {
            "type": "object",
            "properties": {
                "total_compute_cost": { "type": "integer" },
                "total_attention_cost": { "type": "integer" }
            },
            "required": ["total_compute_cost", "total_attention_cost"],
            "additionalProperties": false
        }
    },
    "required": ["agenda_schema_version", "agenda_root", "status"],
    "additionalProperties": false,
    "allOf": [
        {
            "if": {
                "properties": { "status": { "const": "FAILED_INPUT_VALIDATION" } },
                "required": ["status"]
            },
            "then": {
                "properties": {
                    "planner_input_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "planner_spec_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
            },
            "else": {
                "required": ["planner_input_root", "planner_spec_root"]
            }
        }
    ]
}
