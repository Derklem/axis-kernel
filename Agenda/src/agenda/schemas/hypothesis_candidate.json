{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:axis:agenda:hypothesis_candidate:v1.0.0",
    "type": "object",
    "properties": {
        "candidate_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$", "maxLength": 128, "minLength": 1 },
        "expected_information_gain": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "estimated_compute_cost": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "estimated_attention_cost": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "experiment_spec_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "required": ["candidate_id", "expected_information_gain", "estimated_compute_cost", "estimated_attention_cost", "experiment_spec_root"],
    "additionalProperties": false
}
