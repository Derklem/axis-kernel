{
  "version": "1.0",
  "parameter_governance": {
    "retry_interval": {
      "tier": "AUTONOMOUS",
      "limit_range": [
        50,
        5000
      ]
    },
    "semantic_freshness_limit": {
      "tier": "AUTONOMOUS",
      "limit_range": [
        10,
        300
      ]
    },
    "api_timeout": {
      "tier": "OPERATOR_REQUIRED",
      "limit_range": [
        500,
        10000
      ]
    },
    "max_concurrent_simulations": {
      "tier": "LOCKED",
      "value": 10
    }
  },
  "tier_behavior": {
    "on_unauthorized_tier_access": "REJECT_AND_LOG"
  }
}