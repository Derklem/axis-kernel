{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Laboratory Experiment Specification",
  "type": "object",
  "required": ["hypothesis", "procedure", "adapter", "evaluation_criteria"],
  "additionalProperties": false,
  "properties": {
    "hypothesis": { "type": "string" },
    "prediction": { "type": "string" },
    "procedure": { "type": "string" },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "adapter": {
      "type": "object",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["subprocess"] },
        "command": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "timeout_seconds": { 
          "type": "integer", 
          "minimum": 0,
          "maximum": 2147483647,
          "default": 300 
        }
      }
    },
    "evaluation_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "expected_exit_code"],
            "additionalProperties": false,
            "properties": {
              "name": { 
                "type": "string",
                "enum": ["exit_code_equals"]
              },
              "expected_exit_code": { 
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            }
          }
        },
        "subjective_guidelines": { "type": "string" }
      }
    }
  }
}
