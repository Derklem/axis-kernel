{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Laboratory Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "timestamp", "event_schema_version", "event_type", "payload", "previous_hash", "hash"],
  "properties": {
    "sequence": { 
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "event_schema_version": { "type": "string" },
    "event_type": { "type": "string" },
    "payload": { "type": "object" },
    "previous_hash": { "type": ["string", "null"] },
    "hash": { "type": "string" }
  }
}
