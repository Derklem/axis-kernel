{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:axis:verification-report:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_schema_version",
    "run_id",
    "receipt_hash",
    "python_verifier",
    "rust_verifier",
    "normalized_reports_equal"
  ],
  "properties": {
    "verification_schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "python_verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "report_root"],
      "properties": {
        "result": { "enum": ["PASS", "FAIL", "UNVERIFIABLE"] },
        "report_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "rust_verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "report_root"],
      "properties": {
        "result": { "enum": ["PASS", "FAIL", "UNVERIFIABLE"] },
        "report_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "normalized_reports_equal": {
      "type": "boolean"
    }
  }
}
