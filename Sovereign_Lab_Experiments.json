{
    "version": 1,
    "experiments": [
        {
            "id": "EXP-LAB-SMOKE-001",
            "name": "Smoke test: Lab plumbing",
            "description": "Ensure the Lab Engine can run an experiment and write results without altering risk or incidents.",
            "status": "active",
            "scope": "agent",
            "phase": 300,
            "hypothesis": "Running this experiment produces no material change in system risk or incident counts.",
            "inputs": {
                "scenarios": [],
                "required_files": [],
                "preconditions": [
                    "Shadow_Risk_Index.global_score < 0.3"
                ]
            },
            "perturbations": [],
            "metrics": {
                "window_hours": 1,
                "observe": [
                    "Incident_Metrics.doctrine_violation.count",
                    "Shadow_Risk_Index.global_risk_score",
                    "Neural_Proposals.count",
                    "Human_Decisions.count"
                ]
            },
            "expectations": [
                "Shadow_Risk_Index.global_risk_score does not exceed 0.5",
                "Incident_Metrics.doctrine_violation.count does not increase by more than 5"
            ],
            "safety_bounds": {
                "max_global_risk": 0.8,
                "max_new_incidents": 20
            },
            "rollback": {
                "type": "none"
            },
            "tags": [
                "lab",
                "smoke",
                "phase-300"
            ]
        },
