        {
            "id": "EXP-LAB-FED-001",
            "name": "Federation Treaty Sync Smoke Test",
            "description": "Verify that Axis can detect treaty dissonance from a simulated remote node and generate harmonization proposals.",
            "status": "active",
            "scope": "federation",
            "phase": 400,
            "hypothesis": "When presented with a remote treaty snapshot that diverges from local state, Axis will detect dissonance and generate a treaty_harmonization proposal without mutating local treaties directly.",
            "inputs": {
                "scenarios": [],
                "required_files": [],
                "preconditions": [
                    "Treaty_Ledger.treaties.length >= 1"
                ]
            },
            "perturbations": [
                {
                    "type": "script",
                    "script": "D:\\Infinite\\Lab\\Inject_Remote_Treaty_Snapshot.ps1"
                },
                {
                    "type": "command",
                    "command": "Invoke-FederationBridge",
                    "params": {
                        "Full": true
                    }
                },
                {
                    "type": "command",
                    "command": "Invoke-FederationSync",
                    "params": {}
                }
            ],
            "metrics": {
                "window_hours": 0,
                "observe": [
                    "Federation_State.nodes[].dissonance",
                    "Neural_Proposals.proposals[?(@.type == 'treaty_harmonization')].length"
                ]
            },
            "expectations": [
                "Federation_State.nodes[?(@.id == 'NODE-TEST-001')].dissonance == true",
                "Neural_Proposals.proposals[?(@.type == 'treaty_harmonization')].length(after) > Neural_Proposals.proposals[?(@.type == 'treaty_harmonization')].length(before)"
            ],
            "safety_bounds": {
                "max_global_risk": 0.8,
                "max_new_incidents": 10
            },
            "rollback": {
                "type": "none"
            },
            "tags": [
                "lab",
                "federation",
                "phase-400"
            ]
        },
